<Window x:Class="MyVisionDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hv="http://schemas.mvtec.com/halcondotnet"
        Title="空滤器视觉检测系统" Height="750" Width="1280" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Background="#1E1E2E">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="#0F0F1A">
            <Grid>
                <TextBlock Text="空滤器视觉检测系统" Foreground="#7C7CC8" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <!-- 顶栏右侧：实时时钟 -->
                <TextBlock x:Name="TxtClock" Text="" Foreground="#555570" FontSize="14"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- ================= 主区域：左中右三栏 ================= -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================= -->
            <!-- 左栏：设备控制与操作面板 -->
            <!-- ========================================= -->
            <Border Grid.Column="0" Background="#252535" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="设备状态" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- 相机指示灯 -->
                    <Border Background="#1A1A2A" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text=" 相机" Foreground="#9999BB" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Ellipse x:Name="CamStatusLight" Grid.Column="1" Width="14" Height="14" Fill="#555566"/>
                        </Grid>
                    </Border>

                    <!-- PLC 指示灯 -->
                    <Border Background="#1A1A2A" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔌" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text=" PLC" Foreground="#9999BB" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <Ellipse x:Name="PlcStatusLight" Grid.Column="1" Width="14" Height="14" Fill="#555566"/>
                        </Grid>
                    </Border>

                    <!-- PLC 心跳 -->
                    <Border Background="#1A1A2A" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💓" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text=" 心跳" Foreground="#9999BB" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="PlcHeartbeatText" Grid.Column="1" Text="等待" Foreground="Gray" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Resources>
                                    <Storyboard x:Key="HeartbeatAnimation" RepeatBehavior="Forever">
                                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                From="LimeGreen" To="Transparent" Duration="0:0:0.5" AutoReverse="True"/>
                                    </Storyboard>
                                </TextBlock.Resources>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Alive">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource HeartbeatAnimation}"/>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="HeartbeatAnimation"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- ===== 检测计时面板 ===== -->
                    <TextBlock Text="检测计时" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Border Background="#1A1A2A" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <TextBlock Text="匹配耗时" Foreground="#7777AA" FontSize="11"/>
                                <TextBlock x:Name="TxtMatchMs" Text="-- ms" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="条码识别" Foreground="#7777AA" FontSize="11"/>
                                <TextBlock x:Name="TxtBarcodeMs" Text="-- ms" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="总耗时" Foreground="#7777AA" FontSize="11"/>
                                <TextBlock x:Name="TxtTotalMs" Text="-- ms" Foreground="#AAAACC" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Separator Background="#333348" Margin="0,4,0,12"/>

                    <!-- ===== 操作按钮 ===== -->
                    <TextBlock Text="操作面板" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Button Content="📷 连接相机" Height="34" Margin="0,0,0,6" FontSize="12"
                            Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnConnectCamera_Click"/>
                    <Button Content="⏹ 断开相机" Height="34" Margin="0,0,0,6" FontSize="12"
                            Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnDisconnectCamera_Click"/>

                    <Separator Background="#333348" Margin="0,4,0,8"/>

                    <Button x:Name="BtnSelect" Content="📂 选择图片文件夹" Height="34" Margin="0,0,0,6" FontSize="12"
                            Click="BtnSelect_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button x:Name="BtnRun" Content="▶ 开始循环检测" Height="34" Margin="0,0,0,6" FontSize="12"
                            Click="BtnRun_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Content="⏸ 停止循环" Height="34" Margin="0,0,0,6" FontSize="12"
                            Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnStopLoop"/>
                    <Button Content="⚡ 手动触发" Height="34" Margin="0,0,0,6" FontSize="12"
                            Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnSingle"/>
                </StackPanel>
            </Border>

            <!-- ========================================= -->
            <!-- 中栏：双图像显示 -->
            <!-- ========================================= -->
            <Grid Grid.Column="1" Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 窗口1：条码检测 -->
                <Border Grid.Row="0" Background="#0D0D15" CornerRadius="8" BorderThickness="1" BorderBrush="#2A2A3E">
                    <Grid>
                        <TextBlock Text="[ 条码检测 ]" Foreground="#444460" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0"/>
                        <hv:HWindowControlWPF x:Name="Hwin" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"/>
                    </Grid>
                </Border>

                <!-- 窗口2：有无检测 -->
                <Border Grid.Row="2" Background="#0D0D15" CornerRadius="8" BorderThickness="1" BorderBrush="#2A2A3E">
                    <Grid>
                        <TextBlock Text="[ 有无检测 ]" Foreground="#444460" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0"/>
                        <hv:HWindowControlWPF x:Name="Hwin2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================= -->
            <!-- 右栏：检测状态 + 统计看板 + 日志 -->
            <!-- ========================================= -->
            <Border Grid.Column="2" Background="#252535" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                <StackPanel>
                    <!-- 检测状态 -->
                    <TextBlock Text="检测状态" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Border Background="#1A1A2A" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtResult" Text="等待开始..." Foreground="#AAAACC" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ===== 统计看板 ===== -->
                    <TextBlock Text="生产统计" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>

                    <!-- 良率大字显示 -->
                    <Border Background="#1A1A2A" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="良率" Foreground="#7777AA" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtYield" Text="--%" Foreground="#00C853" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- OK / NG / 总数 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- OK -->
                        <Border Grid.Column="0" Background="#1A1A2A" CornerRadius="6" Padding="6,8" Margin="0,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="OK" Foreground="#00C853" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtOKCount" Text="0" Foreground="#00C853" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- NG -->
                        <Border Grid.Column="1" Background="#1A1A2A" CornerRadius="6" Padding="6,8" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="NG" Foreground="#FF5252" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNGCount" Text="0" Foreground="#FF5252" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- 总数 -->
                        <Border Grid.Column="2" Background="#1A1A2A" CornerRadius="6" Padding="6,8" Margin="3,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="总数" Foreground="#7777AA" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotalCount" Text="0" Foreground="#AAAACC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 重置统计按钮 -->
                    <Button Content="🔄 重置统计" Height="28" Margin="0,0,0,14" FontSize="11"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Click="BtnResetStats_Click"/>

                    <Separator Background="#333348" Margin="0,0,0,10"/>

                    <!-- ===== 操作日志 ===== -->
                    <TextBlock Text="操作日志" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="150" Background="#0D0D15" Padding="6" Margin="0,0,0,10">
                        <StackPanel Name="LogPanel">
                            <TextBlock Text="[系统] 等待初始化..." Foreground="#555570" FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== 历史图片查找 ===== -->
                    <TextBlock Text="📂 历史图片查找" Foreground="#8888AA" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSearchHistory" Style="{StaticResource MaterialDesignTextBox}"
                                 Height="30" VerticalContentAlignment="Center" FontSize="12"
                                 ToolTip="输入时间或条码搜索"/>
                        <Button Grid.Column="1" Content="🔍" Width="36" Height="30" Margin="4,0,0,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="BtnSearchHistory_Click"/>
                    </Grid>
                    <ListBox x:Name="HistoryList" Height="80" Background="#0D0D15"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontSize="11" Foreground="#9999BB"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
