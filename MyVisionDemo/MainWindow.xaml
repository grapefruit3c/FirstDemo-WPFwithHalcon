<Window x:Class="MyVisionDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hv="http://schemas.mvtec.com/halcondotnet"
        Title="工业视觉 - 双窗口检测系统" Height="700" Width="1200" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <!-- 整体背景 -->
    <Grid Background="#2D2D30">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- 顶栏 -->
            <RowDefinition Height="*"/>
            <!-- 主区域 -->
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="#007ACC">
            <TextBlock Text="空滤器视觉检测系统" Foreground="White" FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Border>

        <!-- ================= 主区域：左中右三栏 ================= -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <!-- 左栏：相机设置 -->
                <ColumnDefinition Width="*"/>
                <!-- 中栏：双图像显示 -->
                <ColumnDefinition Width="300"/>
                <!-- 右栏：按钮与数据（所有功能放这） -->
            </Grid.ColumnDefinitions>

            <!-- ========================================= -->
            <!-- 左栏：相机控制与参数 -->
            <!-- ========================================= -->
            <Border Grid.Column="0" Background="#252525" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="相机控制" Foreground="#CCCCCC" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>


                    <!-- 相机指示灯 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📷 相机状态" Foreground="Gray" VerticalAlignment="Center"/>
                        <!-- 指示灯：椭圆，命名为 CamStatusLight -->
                        <Ellipse x:Name="CamStatusLight" Grid.Column="1" Width="16" Height="16" Fill="Gray" />
                    </Grid>

                    <!-- PLC 指示灯 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔌 PLC 连接" Foreground="Gray" VerticalAlignment="Center"/>
                        <!-- 指示灯：椭圆，命名为 PlcStatusLight -->
                        <Ellipse x:Name="PlcStatusLight" Grid.Column="1" Width="16" Height="16" Fill="Gray" VerticalAlignment="Top" />
                    </Grid>

                    <!-- PLC 心跳信号（用于显示闪烁） -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💓 PLC 心跳" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlcHeartbeatText" Grid.Column="1" Text="等待连接" Foreground="Gray" FontSize="12" VerticalAlignment="Center">
    <!-- 定义闪烁动画 -->
                            <TextBlock.Resources>
                                <Storyboard x:Key="HeartbeatAnimation" RepeatBehavior="Forever">
                                    <!-- 颜色从 LimeGreen 闪到 Transparent (透明) -->
                                    <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                            From="LimeGreen" To="Transparent" Duration="0:0:0.5" AutoReverse="True"/>
                                </Storyboard>
                            </TextBlock.Resources>
    <!-- 绑定触发器：当 Tag="Alive" 时播放动画，Tag="Dead" 时停止 -->
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Alive">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource HeartbeatAnimation}"/>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="HeartbeatAnimation"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock> 
                    </Grid>

                    <Separator Background="#444444" Margin="0,5,0,10"/>
                    <TextBlock Text="参数调整" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,5"/>

                    <Button Content="连接相机" Height="35" Margin="0,0,0,8" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnConnectCamera_Click"/>
                    <Button Content="断开相机" Height="35" Margin="0,0,0,15" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnDisconnectCamera_Click"/>

                    <TextBlock Text="参数调整" Foreground="#CCCCCC" FontSize="12" Margin="0,10,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="曝光" Foreground="Gray" Width="50"/>
                        <TextBox Text="3000" Width="110" Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="增益" Foreground="Gray" Width="50"/>
                        <TextBox Text="10" Width="110" Style="{StaticResource MaterialDesignTextBox}"/>
                    </StackPanel>
                    <TextBlock Text="操作面板" Foreground="#CCCCCC" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- 您的原按钮，完全放在这里 -->
                    <Button x:Name="BtnSelect" Content="📂 选择图片文件夹" Height="40" Margin="0,0,0,10" 
                            Click="BtnSelect_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>

                    <Button x:Name="BtnRun" Content="▶ 开始检测" Height="40" Margin="0,0,0,15" 
                            Click="BtnRun_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Content="关闭检测" Height="35" Margin="0,0,0,15" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnStopLoop"/>
                    <Button Content="手动触发" Height="35" Margin="0,0,0,15" Style="{StaticResource MaterialDesignRaisedButton}" Click="BtnSingle"/>

                    
                </StackPanel>
            </Border>

            <!-- ========================================= -->
            <!-- 中栏：上下两个 HWindow 窗口 -->
            <!-- ========================================= -->
            <Grid Grid.Column="1" Margin="8,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- 窗口 1 (条码检测) -->
                    <RowDefinition Height="10"/>
                    <!-- 中间的间隔线 -->
                    <RowDefinition Height="*"/>
                    <!-- 窗口 2 (有无检测) -->
                </Grid.RowDefinitions>

                <!-- 窗口1（左上角名字 Hwin，保留您原来的名字） -->
                <Border Grid.Row="0" Background="#111111" CornerRadius="8" BorderThickness="1" BorderBrush="#333333">
                    <Grid>
                        <TextBlock Text="[条码检测]" Foreground="#666666" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0"/>
                        <hv:HWindowControlWPF x:Name="Hwin" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"/>
                    </Grid>
                </Border>

                <!-- 窗口2（留给您后续加代码用，控件名字叫 Hwin2） -->
                <Border Grid.Row="2" Background="#111111" CornerRadius="8" BorderThickness="1" BorderBrush="#333333">
                    <Grid>
                        <TextBlock Text="[有无检测]" Foreground="#666666" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5,0,0"/>
                        <hv:HWindowControlWPF x:Name="Hwin2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="2"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================= -->
            <!-- 右栏：原本的按钮、结果、日志全在这 -->
            <!-- ========================================= -->
            <Border Grid.Column="2" Background="#252525" CornerRadius="8" Padding="15" Margin="8,0,0,0">
                <StackPanel>
                    <!-- 您的原结果显示框 (名字完全保留) -->
                    <TextBlock Text="检测状态" Foreground="#CCCCCC" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                    <Border Background="#1A1A1A" CornerRadius="5" Padding="10" Height="45" Margin="0,0,0,15">
                        <TextBlock x:Name="TxtResult" Text="等待开始..." Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <!-- ====== 新增：历史图片查找 ====== -->
                    <TextBlock Text="📂 历史图片查找" Foreground="#CCCCCC" FontSize="14" FontWeight="Bold" Margin="0,15,0,5"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 历史查找文本框 -->
                        <TextBox x:Name="TxtSearchHistory" Style="{StaticResource MaterialDesignTextBox}" 
                                 Height="30" VerticalContentAlignment="Center" 
                                 ToolTip="输入时间或文件关键字搜索" />

                        <!-- 历史查找按钮 -->
                        <Button Grid.Column="1" Content="🔍" Width="40" Height="30" Margin="5,0,0,0" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Click="BtnSearchHistory_Click"/>
                    </Grid>

                    <!-- 历史列表显示框（用 ListBox 展示历史记录） -->
                    <ListBox x:Name="HistoryList" Height="120" Background="#111111" 
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             Margin="0,0,0,5" FontSize="12" Foreground="LightGray">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Padding="5,2">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- 统计数据 -->
                    <Border Background="#1A1A1A" CornerRadius="5" Padding="8" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✅ OK: 0" Foreground="#00C853" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="❌ NG: 0" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 操作日志 -->
                    <TextBlock Text="操作日志" Foreground="#CCCCCC" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="120" Background="#111111" Padding="5" Margin="0,0,0,10" >
                        <StackPanel Name="LogPanel">
                            <TextBlock Text="[10:05] 系统初始化完成" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                        
                        
                        
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>